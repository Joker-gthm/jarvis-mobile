{
  "id": "./",
  "name": "J.A.R.V.I.S. Mobile",
  "short_name": "JARVIS",
  "description": "Mobile JARVIS-Oberfläche mit Cloud-Memory, Erinnerungen, Abfallkalender, Wetter und Sprache.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#020b10",
  "theme_color": "#03141b",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}